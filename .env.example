# Copy to .env and fill in. Never commit .env.
#
# Default provider is Doubao / Volcengine Seed ASR (录音文件识别大模型):
# https://docs.volcengine.com/docs/DoubaoVoice/ProductOverview-6?lang=zh
#
# QS668_ASR_PROVIDER=doubao|openai

QS668_ASR_PROVIDER=doubao

# --- Doubao (default) ---
# Console: 豆包语音 -> API服务中心 -> 录音文件识别大模型
# Use APP ID + Access Token. Secret Key is not required for this API.
QS668_ASR_DOUBAO_APP_ID=
QS668_ASR_DOUBAO_ACCESS_KEY=
QS668_ASR_DOUBAO_RESOURCE_ID=volc.seedasr.auc
# Speaker diarization (默认开启). Requires show_utterances; use zh-CN or leave language empty.
QS668_ASR_DOUBAO_SPEAKER=true
# 200=non-meeting, 300=long meeting / recorder-card style (default)
QS668_ASR_DOUBAO_SSD_VERSION=300
# New console API Key mode (optional). When set, used instead of APP ID / Access Token.
# QS668_ASR_DOUBAO_API_KEY=

# Aliases also accepted:
# DOUBAO_STT_APP_ID=
# DOUBAO_STT_ACCESS_KEY=

# Language hint. Default zh. Leave empty for auto-detect when the provider supports it.
QS668_ASR_LANGUAGE=zh

# Timeline stamps in corpus markdown.
# absolute = wall clock from noteYYYYMMDD-HHMMSS filename or QS668_ASR_START_TIME
# relative = mm:ss from audio start
QS668_ASR_TIMELINE=absolute
# Optional override when filename has no noteYYYYMMDD-HHMMSS:
# QS668_ASR_START_TIME=2026-10-11 16:18:58

# Long-audio splitting (ffmpeg). Doubao accepts long files, so defaults are higher.
# Split still happens when these limits are exceeded.
QS668_ASR_MAX_BYTES=104857600
QS668_ASR_MAX_SECONDS=14400
QS668_ASR_CHUNK_SECONDS=1800

# --- OpenAI-compatible fallback (optional) ---
# QS668_ASR_PROVIDER=openai
# QS668_ASR_API_KEY=
# QS668_ASR_BASE_URL=https://api.openai.com/v1
# QS668_ASR_MODEL=whisper-1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
